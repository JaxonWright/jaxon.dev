{
  "name": "jaxonwright",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "node version.js && ng serve",
    "build": "node version.js && node scripts/fetch-spotify-playlists.mjs && ng build --configuration production --output-hashing=all",
    "build:ci": "npm run build && cp ./dist/index.html ./dist/404.html",
    "fetch:playlists": "node scripts/fetch-spotify-playlists.mjs",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "inspect": "ng build --configuration production --output-hashing=all --source-map && npx source-map-explorer dist/**/*.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-browser-dynamic": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "luxon": "^3.7.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@angular/language-service": "^22.2.2",
    "@types/jasmine": "~5.1.15",
    "@types/jasminewd2": "~2.0.13",
    "@types/luxon": "^3.7.6",
    "@types/node": "^25.9.9",
    "codelyzer": "^6.0.2",
    "fs-extra": "^11.4.1",
    "git-describe": "^4.1.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.13.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-cli": "~2.0.0",
    "karma-coverage-istanbul-reporter": "~3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "protractor": "~7.0.0",
    "source-map-explorer": "^2.5.3",
    "ts-node": "~10.9.2",
    "tslint": "~6.1.3",
    "typescript": "6.0.3"
  }
}
