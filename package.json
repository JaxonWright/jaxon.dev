{
  "name": "jaxonwright",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "node version.js && npm run data:ensure && ng serve",
    "build": "node version.js && npm run data && ng build --configuration production --output-hashing=all",
    "build:ci": "npm run build && cp ./dist/index.html ./dist/404.html",
    "data": "node scripts/fetch-spotify-playlists.mjs && node scripts/fetch-contributions.mjs",
    "data:ensure": "node scripts/fetch-spotify-playlists.mjs --if-missing && node scripts/fetch-contributions.mjs --if-missing",
    "fetch:playlists": "node scripts/fetch-spotify-playlists.mjs",
    "fetch:contributions": "node scripts/fetch-contributions.mjs",
    "pretest": "npm run data:ensure",
    "test": "ng test",
    "test:scripts": "node --test 'scripts/*.test.mjs'",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "inspect": "ng build --configuration production --output-hashing=all --source-map && npx source-map-explorer dist/**/*.js"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.4",
    "@angular/build": "^22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/language-service": "^22.2.3",
    "@types/node": "^25.9.9",
    "entities": "^8.1.0",
    "fs-extra": "^11.4.1",
    "git-describe": "^4.1.1",
    "jsdom": "^30.1.3",
    "protractor": "~7.0.0",
    "source-map-explorer": "^2.5.3",
    "ts-node": "~10.9.2",
    "tslint": "~6.1.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  }
}
